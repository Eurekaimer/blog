---
import "@/styles/fancybox-custom.css";
// Fancybox 管理器组件（库样式与 JS 按需加载）
---

<script>
  import type { FancyboxOptions } from "@fancyapps/ui";
  import fancyboxCssUrl from "@fancyapps/ui/dist/fancybox/fancybox.css?url";

  let Fancybox: typeof import("@fancyapps/ui").Fancybox;

  function loadStyles() {
    for (const href of [fancyboxCssUrl]) {
      if (document.querySelector(`link[data-fancybox-css="${href}"]`)) continue;
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = href;
      link.dataset.fancyboxCss = href;
      document.head.appendChild(link);
    }
  }

  async function setup() {
    const selectors = [
      ".custom-md img, #post-cover img, .moment-images img",
      ".moment-images a[data-fancybox]",
      "[data-fancybox]:not(.moment-images a)"
    ];

    // 检查页面是否存在需要 Fancybox 的元素
    const hasElements = selectors.some(selector => document.querySelector(selector));

    if (!hasElements) return;

    // 动态导入资源
    if (!Fancybox) {
      loadStyles();
      const mod = await import("@fancyapps/ui");
      Fancybox = mod.Fancybox;
    }

    // 通用配置。The bundled typings omit documented options such as `preload`,
    // so the literal is widened to the library's own option type.
    const commonOptions = {
      Thumbs: {
        autoStart: true,
        showOnStart: "yes",
      },
      Toolbar: {
        display: {
          left: ["infobar"],
          middle: [
            "zoomIn",
            "zoomOut",
            "toggle1to1",
            "rotateCCW",
            "rotateCW",
            "flipX",
            "flipY",
          ],
          right: ["slideshow", "thumbs", "close"],
        },
      },
      animated: true,
      dragToClose: true,
      Hash: false,
      keyboard: {
        Escape: "close",
        Delete: "close",
        Backspace: "close",
        PageUp: "next",
        PageDown: "prev",
        ArrowUp: "next",
        ArrowDown: "prev",
        ArrowRight: "next",
        ArrowLeft: "prev",
      },
      fitToView: true,
      preload: 3,
      infinite: true,
      Panzoom: {
        maxScale: 3,
        minScale: 1,
      },
      caption: false,
    } as Partial<FancyboxOptions>;

    const imageOptions = {
      ...commonOptions,
      groupAll: true,
      Carousel: {
        transition: "slide",
        preload: 2,
      },
    } as Partial<FancyboxOptions>;

    // 绑定图片
    Fancybox.bind(".custom-md img, #post-cover img, .moment-images img", imageOptions);

    // 绑定链接
    Fancybox.bind(".moment-images a[data-fancybox]", {
      ...commonOptions,
      source: (el: Element) => el.getAttribute("data-src") || el.getAttribute("href"),
    } as Partial<FancyboxOptions>);

    // 绑定其他
    Fancybox.bind("[data-fancybox]:not(.moment-images a)", commonOptions);
  }

  function cleanupFancybox() {
    if (Fancybox) {
      Fancybox.close();
      Fancybox.unbind(document.body);
    }
  }

  // 初始化
  setup();

  // Swup 生命周期整合
  document.addEventListener("swup:content:replace", setup);
  document.addEventListener("swup:visit:start", cleanupFancybox);

  // 加密文章解密后重新绑定灯箱
  document.addEventListener("password:decrypted", () => {
    setTimeout(setup, 200);
  });
</script>
