---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateI18nWithTime } from "@/utils/date-utils";
import steamHistory from "@/data/steam-history.json";

if (!siteConfig.pages.steam) {
	return Astro.redirect("/404/");
}

type SteamOwnedGame = {
	appid: number;
	name: string;
	playtime_forever?: number;
	playtime_2weeks?: number;
	img_icon_url?: string;
	rtime_last_played?: number;
};

type SteamOwnedGamesResponse = {
	response?: {
		game_count?: number;
		games?: SteamOwnedGame[];
	};
};

type SteamRecentlyPlayedResponse = {
	response?: {
		total_count?: number;
		games?: SteamOwnedGame[];
	};
};

type SteamStoreAppData = {
	header_image?: string;
	capsule_image?: string;
	capsule_imagev5?: string;
};

type SteamStoreAppDetailsResponse = Record<
	string,
	{
		success?: boolean;
		data?: SteamStoreAppData;
	}
>;

type SteamGame = SteamOwnedGame & {
	playtime_forever: number;
	playtime_2weeks: number;
	coverUrls: string[];
};

type SteamHistorySnapshot = {
	date: string;
	recordedAt?: string;
	totalPlayMinutes: number;
	recentPlayMinutes?: number;
	gameCount?: number;
	playedGameCount?: number;
	topGame?: {
		appid: number;
		name: string;
		playtime_forever: number;
	};
};

type SteamTrendPoint = {
	date: string;
	label: string;
	minutes: number;
	x: number;
	y: number;
	isMarker: boolean;
};

type SteamTrendChart = {
	range: "week" | "month";
	windowSize: number;
	title: string;
	totalMinutes: number;
	averageMinutes: number;
	previousTotalMinutes: number;
	percentChange: number | null;
	percentText: string;
	compareLabel: string;
	insight: string;
	tone: "up" | "down" | "flat" | "new" | "empty";
	path: string;
	areaPath: string;
	gridPath: string;
	points: SteamTrendPoint[];
	startLabel: string;
	endLabel: string;
	maxLabel: string;
	snapshotCount: number;
};

const buildTime = formatDateI18nWithTime(new Date());
const steamId = siteConfig.steam?.steamId?.trim() || "";
const steamApiKey = import.meta.env.STEAM_API_KEY?.trim() || "";
const recentLimit = siteConfig.steam?.recentLimit ?? 8;
const topLimit = siteConfig.steam?.topLimit ?? 12;
const apiBaseUrl = "https://api.steampowered.com/IPlayerService";
const storeDetailsConcurrency = 6;
const storeDetailsTimeoutMs = 5000;

let games: SteamGame[] = [];
let recentGames: SteamGame[] = [];
let fetchStatus: "ok" | "missing_config" | "missing_key" | "empty" | "failed" =
	"ok";

async function fetchSteamJson<T>(
	method: string,
	params: Record<string, string>,
) {
	const url = new URL(`${apiBaseUrl}/${method}/v0001/`);
	for (const [key, value] of Object.entries(params)) {
		url.searchParams.set(key, value);
	}
	url.searchParams.set("format", "json");

	const response = await fetch(url);
	if (!response.ok) {
		throw new Error(`Steam API ${method} failed with ${response.status}`);
	}

	return (await response.json()) as T;
}

async function mapWithConcurrency<T, U>(
	items: T[],
	limit: number,
	mapper: (item: T) => Promise<U>,
) {
	const results: U[] = [];
	let index = 0;

	async function worker() {
		while (index < items.length) {
			const currentIndex = index;
			index += 1;
			results[currentIndex] = await mapper(items[currentIndex]);
		}
	}

	await Promise.all(
		Array.from({ length: Math.min(limit, items.length) }, () => worker()),
	);

	return results;
}

async function fetchSteamStoreDetails(appids: number[]) {
	const details = new Map<number, SteamStoreAppData>();
	const uniqueAppIds = Array.from(new Set(appids));

	const entries = await mapWithConcurrency(
		uniqueAppIds,
		storeDetailsConcurrency,
		async (appid) => {
			const url = new URL("https://store.steampowered.com/api/appdetails");
			url.searchParams.set("appids", String(appid));
			url.searchParams.set("filters", "basic");

			try {
				const response = await fetch(url, {
					signal: AbortSignal.timeout(storeDetailsTimeoutMs),
				});
				if (!response.ok) return undefined;

				const data = (await response.json()) as SteamStoreAppDetailsResponse;
				const detail = data[String(appid)];
				if (!detail?.success || !detail.data) return undefined;

				return [appid, detail.data] as const;
			} catch (error) {
				console.warn(`[Steam] 获取 ${appid} 商店封面失败:`, error);
				return undefined;
			}
		},
	);

	for (const entry of entries) {
		if (entry) details.set(entry[0], entry[1]);
	}

	return details;
}

function getDefaultCoverUrls(appid: number) {
	return [
		`https://cdn.cloudflare.steamstatic.com/steam/apps/${appid}/header.jpg`,
		`https://shared.cloudflare.steamstatic.com/store_item_assets/steam/apps/${appid}/header.jpg`,
		`https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/${appid}/header.jpg`,
	];
}

function uniqueUrls(urls: Array<string | undefined>) {
	return Array.from(
		new Set(
			urls
				.map((url) => url?.trim())
				.filter((url): url is string => Boolean(url)),
		),
	);
}

if (!steamId) {
	fetchStatus = "missing_config";
} else if (!steamApiKey) {
	fetchStatus = "missing_key";
} else {
	try {
		const [ownedData, recentData] = await Promise.all([
			fetchSteamJson<SteamOwnedGamesResponse>("GetOwnedGames", {
				key: steamApiKey,
				steamid: steamId,
				include_appinfo: "true",
				include_played_free_games: "true",
			}),
			fetchSteamJson<SteamRecentlyPlayedResponse>("GetRecentlyPlayedGames", {
				key: steamApiKey,
				steamid: steamId,
				count: String(recentLimit),
			}),
		]);

		const recentByAppId = new Map<number, SteamOwnedGame>();
		for (const game of recentData.response?.games || []) {
			recentByAppId.set(game.appid, game);
		}

		games = (ownedData.response?.games || [])
			.map((game) => {
				const recentGame = recentByAppId.get(game.appid);
				return {
					...game,
					playtime_forever:
						recentGame?.playtime_forever ?? game.playtime_forever ?? 0,
					playtime_2weeks:
						recentGame?.playtime_2weeks ?? game.playtime_2weeks ?? 0,
					img_icon_url: game.img_icon_url || recentGame?.img_icon_url,
					coverUrls: getDefaultCoverUrls(game.appid),
				};
			})
			.sort((a, b) => b.playtime_forever - a.playtime_forever);

		const storeDetails = await fetchSteamStoreDetails(
			games.map((game) => game.appid),
		);
		games = games.map((game) => {
			const detail = storeDetails.get(game.appid);
			return {
				...game,
				coverUrls: uniqueUrls([
					detail?.header_image,
					detail?.capsule_image,
					detail?.capsule_imagev5,
					...game.coverUrls,
				]),
			};
		});

		recentGames = games
			.filter((game) => game.playtime_2weeks > 0)
			.sort((a, b) => b.playtime_2weeks - a.playtime_2weeks)
			.slice(0, recentLimit);

		if (games.length === 0) {
			fetchStatus = "empty";
		}
	} catch (error) {
		console.error("[Steam] 获取数据失败:", error);
		fetchStatus = "failed";
	}
}

const playedGames = games.filter((game) => game.playtime_forever > 0);
const unplayedGames = games.filter((game) => game.playtime_forever === 0);
const totalPlayMinutes = games.reduce(
	(total, game) => total + game.playtime_forever,
	0,
);
const recentPlayMinutes = recentGames.reduce(
	(total, game) => total + game.playtime_2weeks,
	0,
);
const topGames = games.slice(0, topLimit);
const mostPlayedGame = playedGames[0];

function formatHours(minutes: number) {
	if (minutes <= 0) return "0 小时";
	const hours = minutes / 60;
	if (hours < 10) return `${hours.toFixed(1)} 小时`;
	return `${Math.round(hours)} 小时`;
}

function getGameCover(game: SteamGame) {
	return game.coverUrls[0] || getDefaultCoverUrls(game.appid)[0];
}

function getGameIcon(game: SteamGame) {
	if (!game.img_icon_url) return "";
	return `https://media.steampowered.com/steamcommunity/public/images/apps/${game.appid}/${game.img_icon_url}.jpg`;
}

function getStoreUrl(appid: number) {
	return `https://store.steampowered.com/app/${appid}/`;
}

function getLastPlayedText(timestamp?: number) {
	if (!timestamp) return "暂无最近游玩";
	return new Date(timestamp * 1000).toLocaleDateString("zh-CN", {
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	});
}

const chartWidth = 640;
const chartHeight = 190;
const chartPadding = {
	top: 18,
	right: 18,
	bottom: 28,
	left: 34,
};

function getDateKeyInTimeZone(date = new Date()) {
	const parts = new Intl.DateTimeFormat("en-CA", {
		timeZone: siteConfig.timezone || "Asia/Shanghai",
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	}).formatToParts(date);
	const values = Object.fromEntries(
		parts.map((part) => [part.type, part.value]),
	);
	return `${values.year}-${values.month}-${values.day}`;
}

function parseDateKey(dateKey: string) {
	const [year, month, day] = dateKey.split("-").map(Number);
	if (!year || !month || !day) return Number.NaN;
	return Date.UTC(year, month - 1, day);
}

function formatShortDate(dateKey: string) {
	const [, month, day] = dateKey.split("-");
	return `${month}/${day}`;
}

function normalizeHistorySnapshots(
	snapshots: SteamHistorySnapshot[],
	current?: SteamHistorySnapshot,
) {
	const byDate = new Map<string, SteamHistorySnapshot>();

	for (const snapshot of snapshots) {
		if (
			!snapshot?.date ||
			!Number.isFinite(snapshot.totalPlayMinutes) ||
			Number.isNaN(parseDateKey(snapshot.date))
		) {
			continue;
		}
		byDate.set(snapshot.date, snapshot);
	}

	if (current) {
		byDate.set(current.date, current);
	}

	return Array.from(byDate.values()).sort((a, b) =>
		a.date.localeCompare(b.date),
	);
}

function getSnapshotDeltas(snapshots: SteamHistorySnapshot[]) {
	return snapshots.map((snapshot, index) => {
		const previous = snapshots[index - 1];
		return {
			date: snapshot.date,
			minutes: previous
				? Math.max(0, snapshot.totalPlayMinutes - previous.totalPlayMinutes)
				: 0,
		};
	});
}

function formatTrendPercent(percent: number | null) {
	if (percent === null) return "待记录";
	if (Math.abs(percent) < 1) return "持平";
	return `${percent > 0 ? "+" : ""}${Math.round(percent)}%`;
}

function getTrendTone(
	totalMinutes: number,
	previousTotalMinutes: number,
	percentChange: number | null,
): SteamTrendChart["tone"] {
	if (previousTotalMinutes <= 0 && totalMinutes <= 0) return "empty";
	if (previousTotalMinutes <= 0) return "new";
	if (percentChange === null || Math.abs(percentChange) < 5) return "flat";
	return percentChange > 0 ? "up" : "down";
}

function buildTrendInsight(chart: {
	windowSize: number;
	totalMinutes: number;
	previousTotalMinutes: number;
	percentChange: number | null;
	snapshotCount: number;
}) {
	const currentLabel = chart.windowSize === 7 ? "最近 7 次" : "最近 30 次";
	const previousLabel = chart.windowSize === 7 ? "前 7 次" : "前 30 次";

	if (chart.snapshotCount < 2) {
		return `${currentLabel}的时间轴刚开档，先收集几次构建快照；等记录长起来，就能给你写完整战报啦。`;
	}

	if (chart.previousTotalMinutes <= 0 && chart.totalMinutes > 0) {
		return `${currentLabel}记录到 ${formatHours(chart.totalMinutes)}，${previousLabel}还没有可比较数据，像新番第一话刚播，主线已经点亮。`;
	}

	if (chart.totalMinutes <= 0 && chart.previousTotalMinutes <= 0) {
		return `${currentLabel}几乎没有新增游玩，手柄进入省电模式，二次元能量槽安静补魔中。`;
	}

	const percentText = formatTrendPercent(chart.percentChange);

	if ((chart.percentChange ?? 0) >= 25) {
		return `${currentLabel}比${previousLabel}多玩了 ${percentText}，游戏魂明显升温；记得在快乐读档和早点休息之间走一条好路线。`;
	}

	if ((chart.percentChange ?? 0) > 5) {
		return `${currentLabel}比${previousLabel}多玩了 ${percentText}，属于轻量加推主线，状态刚刚好。`;
	}

	if ((chart.percentChange ?? 0) <= -25) {
		return `${currentLabel}比${previousLabel}少玩了 ${percentText.replace("-", "")}，看来现实支线占了上风，游戏存档正在乖乖等你回来。`;
	}

	if ((chart.percentChange ?? 0) < -5) {
		return `${currentLabel}比${previousLabel}少玩了 ${percentText.replace("-", "")}，游玩节奏变清爽了，像把待办和存档都整理了一遍。`;
	}

	return `${currentLabel}和${previousLabel}基本持平，游戏时间稳定巡航，属于很会管理体力条的玩家。`;
}

function buildTrendChart(
	snapshots: SteamHistorySnapshot[],
	windowSize: number,
): SteamTrendChart {
	const range = windowSize === 7 ? "week" : "month";
	const plotWidth = chartWidth - chartPadding.left - chartPadding.right;
	const plotHeight = chartHeight - chartPadding.top - chartPadding.bottom;

	// 按「最近 N 条快照」取窗口，而不是按自然日取窗口：
	// 采集间隔会随 workflow 频率变化（目前 4 天一次），按日取点会让窗口里大片是空的。
	const deltas = getSnapshotDeltas(snapshots);
	const windowDeltas = deltas.slice(-windowSize);
	const previousDeltas = deltas.slice(
		Math.max(0, deltas.length - windowSize * 2),
		Math.max(0, deltas.length - windowSize),
	);
	const rawPoints =
		windowDeltas.length > 0
			? windowDeltas.map((delta) => ({
					date: delta.date,
					label: delta.date ? formatShortDate(delta.date) : "--",
					minutes: delta.minutes,
				}))
			: [{ date: "", label: "--", minutes: 0 }];
	const maxMinutes = Math.max(60, ...rawPoints.map((point) => point.minutes));
	const baseline = chartPadding.top + plotHeight;
	const points = rawPoints.map((point, index) => {
		const x =
			chartPadding.left +
			(rawPoints.length === 1
				? plotWidth / 2
				: (plotWidth * index) / (rawPoints.length - 1));
		const y = baseline - (point.minutes / maxMinutes) * plotHeight;
		return {
			...point,
			x,
			y,
			isMarker:
				point.minutes > 0 || index === 0 || index === rawPoints.length - 1,
		};
	});
	const path = points
		.map((point, index) => `${index === 0 ? "M" : "L"} ${point.x} ${point.y}`)
		.join(" ");
	const areaPath = `${path} L ${points.at(-1)?.x ?? chartPadding.left} ${baseline} L ${points[0]?.x ?? chartPadding.left} ${baseline} Z`;
	const gridPath = [0, 0.5, 1]
		.map((level) => {
			const y = baseline - level * plotHeight;
			return `M ${chartPadding.left} ${y} L ${chartWidth - chartPadding.right} ${y}`;
		})
		.join(" ");
	const totalMinutes = points.reduce(
		(total, point) => total + point.minutes,
		0,
	);
	const previousTotalMinutes = previousDeltas.reduce(
		(total, delta) => total + delta.minutes,
		0,
	);
	const percentChange =
		previousTotalMinutes > 0
			? ((totalMinutes - previousTotalMinutes) / previousTotalMinutes) * 100
			: null;
	const snapshotCount = snapshots.length;
	const chart = {
		range,
		windowSize,
		title: windowSize === 7 ? "近 7 次" : "近 30 次",
		totalMinutes,
		averageMinutes: Math.round(totalMinutes / rawPoints.length),
		previousTotalMinutes,
		percentChange,
		percentText: formatTrendPercent(percentChange),
		compareLabel: "对比前一组",
		tone: getTrendTone(totalMinutes, previousTotalMinutes, percentChange),
		path,
		areaPath,
		gridPath,
		points,
		startLabel: points[0]?.label || "",
		endLabel: points.at(-1)?.label || "",
		maxLabel: formatHours(maxMinutes),
		snapshotCount,
	} satisfies Omit<SteamTrendChart, "insight">;

	return {
		...chart,
		insight: buildTrendInsight(chart),
	};
}

const currentHistorySnapshot =
	fetchStatus === "ok"
		? {
				date: getDateKeyInTimeZone(),
				recordedAt: new Date().toISOString(),
				totalPlayMinutes,
				recentPlayMinutes,
				gameCount: games.length,
				playedGameCount: playedGames.length,
				topGame: mostPlayedGame
					? {
							appid: mostPlayedGame.appid,
							name: mostPlayedGame.name,
							playtime_forever: mostPlayedGame.playtime_forever,
						}
					: undefined,
			}
		: undefined;
const historySnapshots = normalizeHistorySnapshots(
	steamHistory as SteamHistorySnapshot[],
	currentHistorySnapshot,
);
const trendCharts = [
	buildTrendChart(historySnapshots, 7),
	buildTrendChart(historySnapshots, 30),
];

const filters = [
	{ value: "all", label: "全部", count: games.length },
	{ value: "recent", label: "最近游玩", count: recentGames.length },
	{ value: "unplayed", label: "未游玩", count: unplayedGames.length },
].filter((filter) => filter.value === "all" || filter.count > 0);
---

<MainGridLayout title={i18n(I18nKey.steam)} description={i18n(I18nKey.steamDescription)}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-5 sm:px-9 py-6 relative w-full">
			<div class="mb-6">
				<div class="flex items-center gap-3 mb-3">
					<div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
						<Icon name="fa7-brands:steam" class="text-[1.3rem]" />
					</div>
					<div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
						{i18n(I18nKey.steam)}
					</div>
				</div>
				<p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
					{i18n(I18nKey.steamDescription)}
				</p>
				<p class="text-xs text-neutral-500 dark:text-neutral-500 mt-2">
					数据更新于 {buildTime}
				</p>
			</div>

			{fetchStatus === "ok" ? (
				<>
					<section class="steam-summary-grid mb-6">
						<div class="steam-stat">
							<span>游戏库</span>
							<strong>{games.length}</strong>
						</div>
						<div class="steam-stat">
							<span>总游戏时间</span>
							<strong>{formatHours(totalPlayMinutes)}</strong>
						</div>
						<div class="steam-stat">
							<span>近两周</span>
							<strong>{formatHours(recentPlayMinutes)}</strong>
						</div>
						<div class="steam-stat">
							<span>最常玩</span>
							<strong>{mostPlayedGame?.name || "暂无"}</strong>
						</div>
					</section>

					<section class="steam-trend mb-6">
						<div class="steam-trend-header">
							<div class="min-w-0">
								<div class="flex items-center gap-2 mb-2">
									<Icon name="material-symbols:show-chart" class="text-(--primary) text-[1.25rem]" />
									<h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 m-0">游玩时间趋势</h2>
								</div>
								<p class="steam-trend-subtitle">
									按构建快照统计新增游玩时间，采样间隔不固定，数据日期会有滞后
								</p>
							</div>
							<div class="steam-trend-tabs">
								{trendCharts.map((chart) => (
									<button
										class:list={[
											"steam-trend-tab",
											{ "is-active": chart.range === "week" },
										]}
										type="button"
										data-steam-chart-tab={chart.range}
										aria-pressed={chart.range === "week" ? "true" : "false"}
									>
										{chart.title}
									</button>
								))}
							</div>
						</div>

						{trendCharts.map((chart) => (
							<div
								class="steam-trend-panel"
								data-steam-chart-panel={chart.range}
								hidden={chart.range !== "week"}
							>
								<div class="steam-chart-wrap">
									<svg
										class="steam-chart"
										viewBox={`0 0 ${chartWidth} ${chartHeight}`}
										role="img"
										aria-label={`${chart.title}新增游玩时间折线图`}
									>
										<path class="steam-chart-grid" d={chart.gridPath} />
										<path class="steam-chart-area" d={chart.areaPath} />
										<path class="steam-chart-line" d={chart.path} />
										{chart.points
											.filter((point) => point.isMarker)
											.map((point) => (
												<circle
													class:list={[
														"steam-chart-point",
														{ "is-empty": point.minutes === 0 },
													]}
													cx={point.x}
													cy={point.y}
													r={point.minutes > 0 ? 4 : 2.5}
												>
													<title>{`${point.label}：${formatHours(point.minutes)}`}</title>
												</circle>
											))}
										<text class="steam-chart-label" x={chartPadding.left} y={chartHeight - 6}>{chart.startLabel}</text>
										<text class="steam-chart-label" x={chartWidth - chartPadding.right} y={chartHeight - 6} text-anchor="end">{chart.endLabel}</text>
										<text class="steam-chart-label" x={chartPadding.left} y={chartPadding.top + 4}>{chart.maxLabel}</text>
									</svg>
								</div>

								<div class="steam-trend-stats">
									<div class="steam-trend-stat">
										<span>{chart.title}新增</span>
										<strong>{formatHours(chart.totalMinutes)}</strong>
									</div>
									<div class="steam-trend-stat">
										<span>每次均</span>
										<strong>{formatHours(chart.averageMinutes)}</strong>
									</div>
									<div class:list={["steam-trend-stat", `tone-${chart.tone}`]}>
										<span>{chart.compareLabel}</span>
										<strong>{chart.percentText}</strong>
									</div>
								</div>

								<p class:list={["steam-trend-insight", `tone-${chart.tone}`]}>
									{chart.insight}
								</p>
							</div>
						))}
					</section>

					{recentGames.length > 0 && (
						<section class="mb-6">
							<div class="flex items-center gap-2 mb-3">
								<Icon name="material-symbols:schedule" class="text-(--primary) text-[1.25rem]" />
								<h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 m-0">最近玩过</h2>
							</div>
							<div class="steam-recent-list">
								{recentGames.map((game) => (
									<a class="steam-recent-item" href={getStoreUrl(game.appid)} target="_blank" rel="noopener noreferrer nofollow">
										{getGameIcon(game) ? (
											<img src={getGameIcon(game)} alt="" loading="lazy" decoding="async" />
										) : (
											<span class="steam-icon-fallback">
												<Icon name="fa7-brands:steam" />
											</span>
										)}
										<span class="min-w-0">
											<span class="block truncate font-medium">{game.name}</span>
											<span class="block text-xs text-neutral-500 dark:text-neutral-400">{formatHours(game.playtime_2weeks)}</span>
										</span>
									</a>
								))}
							</div>
						</section>
					)}

					<section class="mb-5">
						<div class="flex items-center gap-2 mb-3">
							<Icon name="material-symbols:leaderboard" class="text-(--primary) text-[1.25rem]" />
							<h2 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 m-0">最常玩游戏</h2>
						</div>
						<div class="steam-top-grid">
							{topGames.map((game, index) => (
								<a class="steam-top-item" href={getStoreUrl(game.appid)} target="_blank" rel="noopener noreferrer nofollow">
									<span class="steam-rank">#{index + 1}</span>
									<span class="truncate">{game.name}</span>
									<strong>{formatHours(game.playtime_forever)}</strong>
								</a>
							))}
						</div>
					</section>

					<div class="flex flex-wrap gap-1.5 mb-4">
						{filters.map((filter) => (
							<button
								class:list={[
									"px-3 py-1 rounded-full text-xs font-medium transition-all duration-200",
									{
										"bg-(--primary) text-white shadow-md": filter.value === "all",
										"bg-(--btn-regular-bg) text-(--btn-content) hover:bg-(--btn-regular-bg-hover)": filter.value !== "all",
									},
								]}
								type="button"
								data-steam-filter={filter.value}
							>
								{filter.label}
								<span class="ml-1">({filter.count})</span>
							</button>
						))}
					</div>

					<div class="steam-game-grid">
						{games.map((game) => (
							<a
								class="steam-game-card"
								href={getStoreUrl(game.appid)}
								target="_blank"
								rel="noopener noreferrer nofollow"
								data-steam-game
								data-recent={game.playtime_2weeks > 0 ? "true" : "false"}
								data-unplayed={game.playtime_forever === 0 ? "true" : "false"}
							>
